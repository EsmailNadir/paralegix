{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "tsc -p ../backend/document-layout/tsconfig.json && next build --webpack",
    "start": "next start",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx --ignore-pattern .next --ignore-pattern next-env.d.ts",
    "//test": "`npm test -- <path>` does NOT reach jest: npm does not forward `--` arguments through a nested `npm run`, so this runs the full unit selection whatever you append. Call `npm run test:unit -- <path>` for one file.",
    "test": "npm run test:unit",
    "test:all": "jest",
    "test:watch": "jest --watch",
    "test:unit": "jest --testPathIgnorePatterns \"/node_modules/\" \"tests/perf\" \"\\.live\\.test\\.\"",
    "test:perf": "jest tests/perf",
    "test:services": "jest tests/services/services.live.test.ts",
    "test:integration": "jest tests/services/services.live.test.ts tests/hooks/hooks.live.test.ts",
    "typecheck": "tsc --noEmit",
    "ci:checks": "npm run lint && npm run typecheck && npm run check:service-transport && npm run check:class-migration && npm run check:money-format && npm run check:date-helpers && npm run check:modal-sizing && npm run check:dialog-shell && npm run check:dead-exports",
    "check:service-transport": "node ./scripts/check-service-transport.mjs",
    "check:class-migration": "node ./scripts/check-class-migration.mjs",
    "check:money-format": "node ./scripts/check-money-format.mjs",
    "check:date-helpers": "node ./scripts/check-date-helpers.mjs",
    "check:modal-sizing": "node ./scripts/check-modal-sizing.mjs",
    "check:dialog-shell": "node ./scripts/check-dialog-shell.mjs",
    "check:dead-exports": "node ./scripts/check-dead-exports.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@paralegix/document-layout": "file:../backend/document-layout",
    "@react-pdf/renderer": "^4.3.2",
    "@stripe/react-stripe-js": "7.0.0",
    "@stripe/stripe-js": "10.0.0",
    "@supabase/supabase-js": "^2.117.3",
    "@tanstack/react-query": "^5.104.2",
    "@tiptap/extension-color": "^3.14.0",
    "@tiptap/extension-highlight": "^3.14.0",
    "@tiptap/extension-link": "^3.14.0",
    "@tiptap/extension-mention": "^3.26.0",
    "@tiptap/extension-placeholder": "^3.14.0",
    "@tiptap/extension-table": "^3.14.0",
    "@tiptap/extension-table-cell": "^3.14.0",
    "@tiptap/extension-table-header": "^3.14.0",
    "@tiptap/extension-table-row": "^3.14.0",
    "@tiptap/extension-task-item": "^3.14.0",
    "@tiptap/extension-task-list": "^3.14.0",
    "@tiptap/extension-text-style": "^3.14.0",
    "@tiptap/extension-underline": "^3.14.0",
    "@tiptap/pm": "^3.14.0",
    "@tiptap/react": "^3.14.0",
    "@tiptap/starter-kit": "^3.14.0",
    "@tiptap/suggestion": "^3.26.0",
    "dayjs": "^1.11.13",
    "docx-preview": "^0.4.1",
    "firebase": "^12.14.0",
    "framer-motion": "^12.23.12",
    "heic2any": "^0.0.4",
    "isomorphic-dompurify": "^3.18.0",
    "lucide-react": "^1.55.0",
    "next": "^16.4.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "5.4.296",
    "pizzip": "^3.3.0",
    "posthog-js": "^1.438.7",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-pdf": "^10.4.1",
    "react-signature-canvas": "^1.1.0-alpha.2",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.11",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "axe-core": "^4.14.0",
    "cross-fetch": "^4.1.0",
    "eslint": "^9",
    "eslint-config-next": "^16.4.0",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "tailwindcss": "^4.1.11",
    "typescript": "^6.0.3"
  }
}

{
  "name": "backend",
  "version": "1.0.0",
  "main": "server.ts",
  "scripts": {
    "build": "tsc -p document-layout/tsconfig.json && tsc && tsx scripts/copy-template-fonts.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tools.json && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint src db scripts tests",
    "start": "node dist/server.js",
    "dev": "tsx watch server.ts",
    "dev:dist": "npm run build && node --watch dist/server.js",
    "db:schema:build": "tsx db/build-schema.ts",
    "db:schema:check": "tsx db/build-schema.ts --check",
    "db:catalog-parity": "./scripts/check-catalog-parity.sh",
    "db:pull": "drizzle-kit pull && tsx db/normalize-drizzle-schema.ts",
    "db:drift": "tsx db/check-drizzle-drift.ts",
    "db:raw-query-ratchet": "tsx db/check-raw-query-count.ts",
    "db:user-delete-guards": "tsx db/check-user-delete-guards.ts",
    "db:files-tree": "tsx db/check-files-tree.ts",
    "db:coverage-scope-check": "tsx db/check-coverage-scope.ts",
    "db:dead-exports": "tsx db/check-dead-exports.ts",
    "stripe:reconcile": "tsx ./scripts/reconcile-stripe-payments.ts",
    "stress:setup": "tsx scripts/stress-test/setup.ts",
    "stress:run": "tsx scripts/stress-test/run.ts",
    "stress:teardown": "tsx scripts/stress-test/teardown.ts",
    "//test": "Duplicates test:unit on purpose. Aliasing it to `npm run test:unit` looks tidier and is wrong: npm does not forward `--` arguments through a nested `npm run`, so `npm test -- <path>` would silently run the WHOLE suite instead of one file. --passWithNoTests=false (already the default) closes the --selectProjects list for the same reason: without it, a path appended by `npm test -- <path>` is read as a second project name and the whole suite runs.",
    "test": "node --no-concurrent-marking node_modules/.bin/jest --selectProjects unit --passWithNoTests=false",
    "test:unit": "node --no-concurrent-marking node_modules/.bin/jest --selectProjects unit --passWithNoTests=false",
    "test:live": "tsx ./tests/live/validate-test-env.ts && jest --selectProjects live --maxWorkers=1",
    "test:coverage": "node --no-concurrent-marking node_modules/.bin/jest --selectProjects unit --passWithNoTests=false --coverage",
    "test:watch": "node --no-concurrent-marking node_modules/.bin/jest --selectProjects unit --passWithNoTests=false --watch",
    "test:db": "./scripts/setup-test-db.sh"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "Backend server for your project",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@google-cloud/storage": "^8.4.0",
    "@paralegix/document-layout": "file:document-layout",
    "@pdf-lib/fontkit": "^1.1.1",
    "@signpdf/placeholder-pdf-lib": "^3.3.0",
    "@signpdf/signer-p12": "^3.3.0",
    "@signpdf/signpdf": "^3.3.0",
    "archiver": "^7.0.1",
    "cors": "^2.8.5",
    "dayjs": "^1.11.13",
    "docxtemplater": "^3.71.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "firebase-admin": "^14.0.0",
    "geoip-lite": "^2.0.3",
    "hash-wasm": "^4.12.0",
    "helmet": "^8.2.0",
    "html-to-docx": "^1.8.0",
    "htmlparser2": "^12.0.0",
    "jsonwebtoken": "^9.0.2",
    "libreoffice-convert": "^1.8.1",
    "node-forge": "^1.4.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.21.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pizzip": "^3.2.0",
    "posthog-node": "^5.56.1",
    "puppeteer-core": "^24.43.1",
    "resend": "^6.33.0",
    "sanitize-html": "^2.18.1",
    "stripe": "^22.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.20.2",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "jest": "^30.3.0",
    "jpeg-js": "0.4.4",
    "pdfjs-dist": "^4.8.69",
    "puppeteer": "^24.43.1",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.15",
    "ts-prune": "^0.10.3",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}

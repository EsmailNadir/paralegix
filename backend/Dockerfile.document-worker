# ---- build stage: compile the worker entry point ----
FROM node:22-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
COPY document-layout ./document-layout
# The `puppeteer` dev dependency would download a Chrome here that nothing runs:
# the runtime stage drives the system Chromium it installs.
ENV PUPPETEER_SKIP_DOWNLOAD=true
RUN npm ci
COPY tsconfig.json ./
COPY src ./src
# `npm run build` ends in `tsx scripts/copy-template-fonts.ts`, so scripts/ has
# to be here even though the worker itself never reads the fonts. The API image
# needs the same copy for the same reason.
COPY scripts ./scripts
RUN npm run build
# The worker loads two packages, so the runtime stage must not install the API's
# whole dependency list. This writes a package.json naming only the worker's
# packages, then prunes a copy of the API lockfile to match it. The pruned
# lockfile keeps the API's locked versions, so the runtime stage can still use
# `npm ci`. tests/config/documentWorkerImage.test.ts keeps the list in step
# with what src/document-worker.ts imports.
RUN npx tsx scripts/write-worker-manifest.ts worker-manifest && \
    cp package-lock.json worker-manifest/ && \
    cp -r document-layout worker-manifest/document-layout && \
    cd worker-manifest && \
    npm install --package-lock-only --ignore-scripts --no-audit --no-fund

# ---- runtime stage: document conversion and PDF export only ----
# Chromium renders filled HTML templates to PDF (src/shared/documentConversion/
# htmlPdf.ts). `puppeteer-core` ships no browser, so it drives this one, found
# through CHROMIUM_PATH. The font packages give Chromium metric-compatible
# stand-ins for the editor's Arial, Times New Roman, Courier New, Calibri and
# Cambria, so a line wraps where it wrapped in the editor.
FROM node:22-slim
RUN apt-get update && \
    apt-get install -y --no-install-recommends libreoffice-core libreoffice-writer chromium fonts-liberation fonts-crosextra-carlito fonts-crosextra-caladea && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*
ENV CHROMIUM_PATH=/usr/bin/chromium

WORKDIR /app
ENV NODE_ENV=production
COPY --from=build /app/worker-manifest/package.json /app/worker-manifest/package-lock.json ./
COPY --from=build /app/document-layout ./document-layout
RUN npm ci --omit=dev
COPY --from=build /app/dist ./dist

# LibreOffice parses documents that users upload, so it runs without root. The
# node user comes with the base image, and /app stays owned by root. HOME must
# be a directory this user can write: LibreOffice's font cache goes there, and
# with an unwritable HOME every conversion fails. It is set here, not left to
# the runtime, so the value never depends on how the platform starts the user.
ENV HOME=/home/node
USER node

EXPOSE 8080
CMD ["node", "dist/document-worker.js"]

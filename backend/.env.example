# Paralegix Backend — copy to `.env` and fill in. Values are placeholders.

# ── Core ────────────────────────────────────────────────────────────────
PORT=5001
NODE_ENV=development

# ── Database (Postgres / Supabase) ──────────────────────────────────────
# DB_TARGET picks which connection string below the app, db/apply-schema.ts and
# db/run-sql.ts use. Unset means DATABASE_URL is used instead.
DB_TARGET=staging
DATABASE_URL_LOCAL=postgresql://postgres:postgres@localhost:5433/paralegix
DATABASE_URL_STAGING=
DATABASE_URL_PROD=
# Base name for the in-process Jest suite's databases. tests/support/db.ts appends
# _$JEST_WORKER_ID, so worker 1 uses paralegix_test_1. Build them with
# ./scripts/setup-test-db.sh; never point this at a database holding real data.
DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5433/paralegix_test
# Fallback when DB_TARGET is unset.
DATABASE_URL=
# PG_POOL_MAX=10
# PG_POOL_RESERVE=3
# PG_STATEMENT_TIMEOUT_MS=30000

# ── Firebase Auth + GCS storage (Auth and storage only) ────────────────
# Service account JSON as a single-line string, or place serviceAccountKey.json in /backend/.
FIREBASE_SERVICE_ACCOUNT_KEY=
GCS_BUCKET=lawfirm

# ── URLs ────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
WEBHOOK_BASE_URL=http://localhost:5001
# APP_URL=http://localhost:3000
# APP_ORIGIN=
# Comma-separated allowlist read by src/app.ts.
# CORS_ORIGINS=

# ── Messaging Realtime (Supabase RLS) ───────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# ── Docs site sign-in gate ──────────────────────────────────────────────
# Shared secret for the cookie that unlocks the documentation site. The SAME
# value must be set on the docs Vercel project, which verifies it at the edge.
# Generate with: openssl rand -base64 48
DOCS_SESSION_SECRET=
# Parent domain the cookie is scoped to, so the app and the docs host both see
# it (e.g. .paralegix.com). Leave BLANK locally: app, API and docs are all
# localhost there, and a host-only cookie already spans their ports.
# DOCS_COOKIE_DOMAIN=
# Cookie name; defaults to plx_docs. Must match the docs project.
# DOCS_COOKIE_NAME=

# ── Email (Resend) — emails are skipped if unset ────────────────────────
RESEND_API_KEY=
# EMAIL_FROM=Paralegix <noreply@paralegix.com>
# DISABLE_ALL_REMINDER_EMAILS=false

# ── Stripe billing ──────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_SUBSCRIPTION_WEBHOOK_SECRET=whsec_...
# Signing secret of the separate Connect endpoint (events from connected accounts,
# i.e. account.updated) that also points at /api/webhooks/stripe. Optional locally:
# `stripe listen --forward-connect-to` signs with the same secret as STRIPE_WEBHOOK_SECRET.
# STRIPE_CONNECT_WEBHOOK_SECRET=whsec_...
# Paralegix's fee on a direct charge (a firm on a Standard account pays Stripe's fee itself).
# STRIPE_DIRECT_APPLICATION_FEE_RATE=0.009
# STRIPE_DIRECT_APPLICATION_FEE_FIXED_CENTS=0
# Every paid tier needs both intervals: a missing price id rejects checkout for that
# tier/interval combination with "Invalid plan or interval".
STRIPE_BASIC_MONTHLY_PRICE_ID=
STRIPE_BASIC_ANNUAL_PRICE_ID=
STRIPE_PROFESSIONAL_MONTHLY_PRICE_ID=
STRIPE_PROFESSIONAL_ANNUAL_PRICE_ID=
STRIPE_ENTERPRISE_MONTHLY_PRICE_ID=
STRIPE_ENTERPRISE_ANNUAL_PRICE_ID=
# Platform fee on client payments (defaults to 3.8% + 30¢). Rate is decimal, fixed is cents.
# It is also the card cost a firm can pass on to its client (src/modules/stripe/processingFees.ts).
STRIPE_APPLICATION_FEE_RATE=0.038
STRIPE_APPLICATION_FEE_FIXED_CENTS=30
# Bank transfer (ACH) cost on client payments: Stripe's rate and cap, plus the margin below.
# STRIPE_ACH_FEE_RATE=0.008
# STRIPE_ACH_FEE_CAP_CENTS=500
# The Paralegix margin: the whole fee on a direct charge, and part of the bank cost.
# STRIPE_DIRECT_APPLICATION_FEE_RATE=0.009
# Clawback recovery. OFF by default: on a dispute, refund or ACH return Stripe debits
# the platform, and with this off the code only logs what it WOULD reverse, so every
# clawback is a platform loss until it is switched on. Decide this deliberately per
# environment rather than leaving the default in place.
# STRIPE_AUTO_RECOVERY_ENABLED=false
# Processing fee on an electronic trust deposit, billed to the firm's operating side.
# Rate is decimal, cap is cents (defaults to 0.8% capped at $5.00).
# STRIPE_TRUST_ACH_FEE_RATE=0.008
# STRIPE_TRUST_ACH_FEE_CAP_CENTS=500
# Payout delay on a connected account, in days. Longer means more time to catch a
# reversal before the money has left the platform.
# STRIPE_CONNECT_PAYOUT_DELAY_DAYS=7
# How long a payment-intent lock may be held before it is treated as abandoned, in ms.
# STRIPE_PAYMENT_INTENT_LOCK_MAX_HOLD_MS=120000
# Seconds a webhook event's 'processing' claim in stripe_events is honoured before a
# later delivery may reclaim it (recovers events whose process died mid-handler).
# STRIPE_EVENT_CLAIM_STALE_SECONDS=600

# ── Product analytics (PostHog) : server events are skipped if unset ─────
# Project token for the backend's own events (firm created, subscription
# lifecycle, client invoice paid). Ids, enums and booleans only; no client data.
# Leave empty locally. The test suite forces it empty.
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=https://us.i.posthog.com
# Account erasure also deletes the person from PostHog, through the private API.
# A personal API key (scope: person write, this project only) is a SECRET, unlike
# the project token. Leave empty locally; the test suite forces it empty.
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=
# POSTHOG_API_HOST=https://us.posthog.com

# ── Google OAuth / Calendar ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5001/api/auth/google-callback

# ── Microsoft OAuth / Outlook ───────────────────────────────────────────
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:5001/api/auth/microsoft-callback

# ── E-signature sealing certificate ─────────────────────────────────────
# Leave both unset for local development: the backend falls back to the
# gitignored dev cert at backend/paralegix-signing.p12 (create it with
# `npx tsx scripts/generate-signing-cert.ts`) and an empty passphrase.
# REQUIRED on every deployed environment. With NODE_ENV=production the backend
# refuses to seal without both, so every signing request fails at finalize.
# Staging mounts its .p12 from Secret Manager; see docs/STAGING_SETUP.md.
# SIGNING_P12_PATH=
# P12_PASSPHRASE=

# ── Cron / scheduled jobs ───────────────────────────────────────────────
# REQUIRED on every deployed environment, staging included. It is the whole
# authorization for /api/cron/*, which moves money (reconcile-billing,
# reconcile-trust-deposits, trust-fee-sweep) and mails every client (reminders,
# digest). Cloud Scheduler sends it as `Authorization: Bearer <secret>` or
# `x-cron-secret: <secret>`; without it every cron route answers 503 and no
# scheduled job runs at all.
#
# Leaving it blank is safe ONLY for local development. With no secret set, a
# cron route accepts `x-cloudscheduler: true` from a loopback connection when
# NODE_ENV is exactly `test` or `development`, and refuses everything else. That
# hatch does not exist on a deployment: any other NODE_ENV, or any request that
# arrived through a proxy, is refused whatever headers it carries. There is no
# "not production" fallback any more.
#
# Generate one with: openssl rand -hex 32
CRON_SECRET=
# Housekeeping sweep of accounts whose email was never verified. Signup
# registers the address before it is proven, so without this a signup using
# someone else's email blocks the real owner from ever registering.
# MODE DEFAULTS TO dry-run: the sweep reports what it would delete and deletes
# nothing. Set it to `on` only after reading a few dry runs; `off` skips the
# pass entirely.
# UNVERIFIED_ACCOUNT_SWEEP_MODE=dry-run
# UNVERIFIED_ACCOUNT_GRACE_DAYS=7
# UNVERIFIED_ACCOUNT_SWEEP_BATCH=200

# ── Feature flags & limits ──────────────────────────────────────────────
# RBAC: when off, every member gets the full permission set. Verify all members
# have a role before enabling.
RBAC_ENFORCED=true
# MAINTENANCE_MODE=false
# EMAIL_VERIFICATION_WHITELIST=
# MAX_LAW_FIRMS_PER_USER=

# ── Event outbox worker (optional tuning) ───────────────────────────────
# Each commented value below is the default already in code; set one only to override it.
# EVENT_OUTBOX_WORKER=false
# EVENT_OUTBOX_POLL_MS=30000
# EVENT_OUTBOX_BATCH=20
# EVENT_OUTBOX_MAX_ATTEMPTS=5
# EVENT_OUTBOX_BACKOFF_MS=30000
# EVENT_OUTBOX_LEASE_MS=300000

# ── Rate limiting ───────────────────────────────────────────────────────
# Every cap below has a safe default in code; set one only to override it.
# See docs/dev/admin/rate-limiting.md for what each one guards.
# Number of proxy hops in front of the app. 1 is correct for Cloud Run's
# single Google front end; RAISE IT if you put a load balancer, CDN or Cloud
# Armor in front, or every IP-keyed limiter will key on the proxy instead of
# the client and collapse into one shared bucket.
# TRUST_PROXY_HOPS=1
# Per-IP and per-account backstops
# GLOBAL_RATE_LIMIT_MAX=1000
# USER_RATE_LIMIT_MAX=600
# HEAVY_READ_RATE_LIMIT_MAX=240
# UPLOAD_RATE_LIMIT_MAX=120
# Auth surface
# AUTH_RATE_LIMIT_MAX=30
# AUTH_FAILURE_RATE_LIMIT_MAX=100
# USER_EXISTS_RATE_LIMIT_MAX=10
# OAUTH_CALLBACK_RATE_LIMIT_MAX=20
# INVITE_LOOKUP_RATE_LIMIT_MAX=30
# Feature surfaces
# MESSAGE_SEND_RATE_LIMIT_MAX=30
# PORTAL_MESSAGE_SEND_RATE_LIMIT_MAX=30
# CONVERT_RATE_LIMIT_MAX=30
# TEMPLATE_RENDER_RATE_LIMIT_MAX=60
# PUBLIC_SHARE_RATE_LIMIT_MAX=30
# Public signing surface
# SIGNING_ACTION_RATE_LIMIT_MAX=10
# SIGNING_READ_RATE_LIMIT_MAX=120
# SIGNING_VERIFY_RATE_LIMIT_MAX=10
# SIGNING_GATE_RATE_LIMIT_MAX=5
# Per-recipient daily email cap (0 disables)
# EMAIL_MAX_PER_RECIPIENT_PER_DAY=100

# Filling a template is a genuine transform: docxtemplater and pdf-lib both need
# the whole file. The cost cannot be removed, only bounded, and it is bounded
# from the object's metadata BEFORE the read. Placement images are fetched one
# at a time against a running total, because in parallel the peak is the number
# of placements times the per-image cap.
# TEMPLATE_MAX_BYTES=26214400
# TEMPLATE_IMAGE_MAX_BYTES=10485760
# TEMPLATE_IMAGE_TOTAL_MAX_BYTES=26214400

# How much document work one API instance runs at once, and how long a request
# waits for a place before it is refused with a retryable 503 (TEMPLATE_FILL_BUSY,
# CONVERSION_BUSY). All are PER INSTANCE. A TEMPLATE_* value that is not a
# positive integer keeps its default. cloudbuild.yaml passes each one from a substitution whose
# default equals the value here, and its comment holds the budget that binds
# them to the worker's and the database's capacity.
# DOC_CONVERT_CONCURRENCY=1
# DOC_CONVERT_QUEUE_TIMEOUT_MS=45000
# TEMPLATE_FILL_CONCURRENCY=2
# TEMPLATE_FILL_QUEUE_TIMEOUT_MS=30000
# TEMPLATE_EXPORT_CONCURRENCY=1
# TEMPLATE_EXPORT_QUEUE_TIMEOUT_MS=45000
# TEMPLATE_RENDERS_PER_PERSON=2

# The largest non-PDF source converted to PDF for signing. Unset, it follows
# where conversion runs: 100 MiB on the document worker (DOCUMENT_CONVERTER=
# worker), which never puts the file in this process, and 25 MiB otherwise,
# because the in-process converter reads the whole file into a 512 MiB container
# serving eighty requests. Setting it overrides both. The converted output still
# faces the signing source cap afterwards.
# SIGNING_UPLOAD_BUFFER_BYTES=26214400

# The largest source whose preparation runs inside the finalize request.
# Preparation hashes the whole document, and doing that behind an interactive
# request works while documents are small and stops working exactly when it
# matters: the request times out, the caller sees a failure, and the work carries
# on invisibly until the instance is killed. Past this the route answers 202 with
# a job id and the client polls. Deliberately independent of the source cap, so
# raising what may be signed does not silently move what is hashed while someone
# waits.
# SIGNING_INLINE_PREPARE_BYTES=8388608

# The largest source whose FINALIZE runs inside the last signer's request.
# Finalizing appends, so the source is never read and the work does not grow with
# the document. What still grows is what happens after the seals, above all the
# archive and filing copies storage has to make. Past this the completion answers
# 202 and the drain finishes the document; the signer's consent is committed
# either way, so nothing is lost by not waiting.
# SIGNING_INLINE_FINALIZE_BYTES=33554432

# The largest executed document still delivered as an email ATTACHMENT. Above it
# each recipient gets a link bound to that recipient and to that version of that
# artifact, and the bytes never enter the process. The number comes from what a
# mailbox will take: base64 inflates a PDF by about a third, and mainstream
# providers refuse a message somewhere between 20 and 25 MiB.
# SIGNING_ATTACHMENT_MAX_BYTES=5242880

# Bytes reserved in the document for each seal. An RSA-2048 CMS blob is around
# 2 KB and a certificate chain makes it larger, so the reservation GROWS rather
# than being guessed generously: a fixed 64 KiB hole in every signed document is
# 64 KiB of nothing, and a fixed 8 KiB one refuses a chain that is perfectly
# valid. Growing rebuilds the whole suffix, so every offset and the digest come
# from the new layout. The ceiling exists so a chain that is wrong rather than
# large fails with a stated reason instead of enlarging the hole until something
# else breaks.
# SIGNING_CONTENTS_CAPACITY=8192
# SIGNING_MAX_CONTENTS_CAPACITY=65536

# The signing profile: what this service will and will not sign.
#
# The numbers live in src/modules/signatures/signingProfile.ts and are versioned.
# The version is recorded on every admitted source, so changing a limit does not
# silently reclassify documents already admitted under the old rules.
#
# The two page limits are separate on purpose. A source accepted at exactly the
# total would fail at the end, when the service appends its own certificate, and
# the user would be told their document is too long by the system that made it
# longer.
# SIGNING_MAX_SOURCE_BYTES=20971520
# SIGNING_MAX_SOURCE_PAGES=2000
# SIGNING_MAX_CERTIFICATE_PAGES=20
# SIGNING_MAX_IMAGE_PIXELS=40000000
# SIGNING_MAX_SIGNATURE_IMAGE_BYTES=524288
# SIGNING_MAX_SIGNATURE_IMAGE_TOTAL_BYTES=4194304
# SIGNING_MAX_COMPLETION_BYTES=8388608
#
# The PDF engine's own ceilings. The profile reads these rather than restating
# them. PDF_MAX_XREF_BYTES is the one that decides how many objects a document
# may declare: the index is the one structure whose size follows the document
# rather than the window being read.
# PDF_MAX_READ_BYTES=8388608
# PDF_MAX_XREF_BYTES=50331648
# PDF_MAX_REVISIONS=64
# PDF_MAX_PAGE_TREE_NODES=200000
# PDF_DIGEST_WINDOW_BYTES=4194304

# Durable signing work (preparation hashes, finalization seals).
#
# The drain at POST /api/cron/signing-jobs holds an open request while it works,
# because Cloud Run stops scheduling CPU once a response is sent. Its budget is
# deliberately larger than the ordinary cron passes' and well under Cloud Run's
# 3600-second request ceiling. The scheduler for it runs every minute with a
# 30-minute HTTP attempt deadline; its default deadline is far shorter than the
# work, and a scheduler that gives up mid-drain retries a job the drain is still
# inside.
#
# SIGNING_PDF_SLOT_CONCURRENCY is PER INSTANCE, like DOC_CONVERT_CONCURRENCY.
# Total concurrency is this times the instance count, so raising max-instances
# raises peak memory demand too.
# SIGNING_JOB_LEASE_SECONDS=60
# SIGNING_JOB_DRAIN_BUDGET_MS=1500000
# SIGNING_JOB_HEADROOM_MS=300000
# SIGNING_JOB_MAX_ATTEMPTS=6
# SIGNING_PDF_SLOT_CONCURRENCY=3
# SIGNING_PDF_SLOT_TIMEOUT_MS=60000
# Completion emails are claimed before sending and stamped after. A claim held
# past the lease is taken over by the drain (a rare duplicate copy beats a lost
# one), and a delivery is retried up to the attempt cap.
# SIGNING_DELIVERY_LEASE_SECONDS=600
# SIGNING_DELIVERY_MAX_ATTEMPTS=5

# Folder exports. A folder download is a durable job that streams one zip into a
# temporary object, claimed under a lease so a stalled worker and its
# replacement cannot both publish and bill the transfer twice. The page size is
# how many tree rows the worker holds at once, so memory tracks the page rather
# than the folder.
# FILES_EXPORT_LEASE_SECONDS=120
# FILES_EXPORT_DRAIN_BUDGET_MS=1500000
# FILES_EXPORT_HEADROOM_MS=300000
# FILES_EXPORT_MAX_ATTEMPTS=5
# FILES_EXPORT_PAGE_SIZE=200
# How long a finished archive stays fetchable, and how long one minted url lasts.
# FILES_EXPORT_TTL_MS=86400000
# FILES_EXPORT_URL_TTL_MS=3600000

# One heavy transfer at a time per instance, SHARED between signing and folder
# exports: both move whole documents through the same container budget, so
# giving each its own would put two through one allocation. Defaults to the
# SIGNING_PDF_SLOT_* values above when unset.
# TRANSFER_SLOT_CONCURRENCY=1
# TRANSFER_SLOT_TIMEOUT_MS=60000

# The Chromium binary HTML template PDF export launches. The document-worker
# image sets it. Locally it can stay unset: the API then uses the browser the
# `puppeteer` dev dependency downloads (`npm rebuild puppeteer` if npm skipped it).
# CHROMIUM_PATH=/usr/bin/chromium

# Client identity verification through Credence ID (Cloud SDK). Staging only for
# now. Server-side secrets: never expose them with a NEXT_PUBLIC_ prefix. With any
# of the four unset, the portal shows verification as unavailable and the start
# route answers 503 IDENTITY_VERIFICATION_UNCONFIGURED. CREDENCE_ORIGIN must be the
# site origin registered with Credence; it is sent as Origin on every call. The
# base URL is the one Credence's API reference documents; their React sample
# defaults to https://credenceid.com/cloudsdkdev instead.
# CREDENCE_BASE_URL=https://credenceid.com/cloudsdk/playground
# CREDENCE_LICENSE_KEY=
# CREDENCE_PROFILE_ID=
# CREDENCE_ORIGIN=https://staging.paralegix.com
# Starts allowed per portal account per hour (default 10).
# IDENTITY_VERIFICATION_START_RATE_LIMIT_MAX=10

# Running the integration suite drives one account from one IP, which can trip
# the account and global caps on a fast run. Lift them for the server under test:
#   USER_RATE_LIMIT_MAX=100000 GLOBAL_RATE_LIMIT_MAX=100000 npm run dev
